# URL base de la API (relativa en producción bajo /ghcontadores/)
VITE_API_URL=/ghcontadores/api/v1

# true  -> todo el panel funciona en memoria + localStorage (sin backend)
# false -> axios habla con VITE_API_URL
VITE_USE_MOCKS=true

# Hub SignalR para tiempo real (solo se usa con VITE_USE_MOCKS=false)
VITE_HUB_URL=/ghcontadores/hubs/realtime
