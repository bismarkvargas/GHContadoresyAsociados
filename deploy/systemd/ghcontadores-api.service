[Unit]
Description=GH Contadores y Asociados - API (.NET 8)
Documentation=https://github.com/bismarkvargas/GHContadoresyAsociados
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/var/www/ghcontadores/api
ExecStart=/root/.dotnet/dotnet /var/www/ghcontadores/api/GH.Api.dll

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:8095
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=ghcontadores-api
User=root

# Registro estructurado en el journal del sistema: journalctl -u ghcontadores-api -f
StandardOutput=journal
StandardError=journal

# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/www/ghcontadores/api/storage

[Install]
WantedBy=multi-user.target
